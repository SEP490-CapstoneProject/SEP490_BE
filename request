EvaluationCriteria
public class EvaluationCriteria
{
    public Guid Id { get; set; }

    public string Name { get; set; }

    public string Description { get; set; }
}
CriteriaSkillMapping
public class CriteriaSkillMapping
{
    public Guid CriteriaId { get; set; }

