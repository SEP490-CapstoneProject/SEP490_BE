  =====================================================                                                                         
  INJECTION ALGORITHM                                                                                                           
  =====================================================                                                                         
                                                                                                                                
  Rules:                                                                                                                        
  - inject after random interval (5-10)                                                                                         
  - no consecutive sponsored items                                                                                              
  - respect frequency cap                                                                                                       
                                                                                                                                
  Pseudo logic:                                                                                                                 
                                                                                                                                
  nextInject = random(5,10)                                                                                                     
                                                                                                                                
  for each normal item:                                                                                                         
      add normal item                                                                                                           
                                                                                                                                
      if currentPosition >= nextInject:                                                                                         
          inject sponsored item                                                                                                 
          nextInject += random(5,10)                                                                                            
                                                                                                                                
  =====================================================                                                                         
  RANKING ENGINE                                                                                                                
  =====================================================                                                                         
                                                                                                                                
  Sponsored ranking score:                                                                                                      
                                                                                                                                
  score =                                                                                                                       
  priorityScore * 0.5                                                                                                           
  + remainingImpressionRatio * 0.3                                                                                              
  + ctr * 0.2                                                                                                                   
                                                                                                                                
