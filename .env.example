# =============================================================================
# DEVELOPMENT ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in actual values
# DO NOT commit .env file to Git!
# =============================================================================

# Database Configuration
SQLSERVER_PASSWORD=YourStrong@Passw0rd

# JWT Configuration
JWT_SECRET=your-256-bit-secret-key-here-must-be-at-least-32-characters-long
JWT_ISSUER=skillsnap-api
JWT_AUDIENCE=skillsnap-client

# VNPay Configuration (Get from VNPay Dashboard)
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5014/api/payments/return/vnpay
VNPAY_IPN_URL=http://localhost:5014/api/payments/webhook/vnpay

# MoMo Configuration (Get from MoMo Dashboard)
MOMO_PARTNER_CODE=YOUR_MOMO_PARTNER_CODE
MOMO_ACCESS_KEY=YOUR_MOMO_ACCESS_KEY
MOMO_SECRET_KEY=YOUR_MOMO_SECRET_KEY
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:5014/api/payments/return/momo
MOMO_IPN_URL=http://localhost:5014/api/payments/webhook/momo

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Redis Configuration
REDIS_CONNECTION=redis:6379

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Service URLs (for local development)
SERVICE_AUTH=http://auth-service:8080
SERVICE_USERPROFILE=http://userprofile-service:8080
SERVICE_PORTFOLIO=http://portfolio-service:8080
SERVICE_COMPANY=http://company-service:8080
SERVICE_CONNECTION=http://connection-service:8080
SERVICE_COMMUNITY=http://community-service:8080
SERVICE_SUBSCRIPTION=http://subscription-service:8080
SERVICE_NOTIFICATION=http://notification-service:8080
SERVICE_MEDIA=http://media-service:8080
SERVICE_APPLICATION=http://application-service:8080
SERVICE_PAYMENT=http://payment-service:8080
