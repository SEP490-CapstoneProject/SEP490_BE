{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      },
      "Https": {
        "Url": "https://0.0.0.0:8081",
        "Certificate": {
          "Path": "/https/aspnetapp.pfx",
          "Password": "YourSecurePassword123!"
        }
      }
    }
  },
  "ServiceUrls": {
    "AuthService": "http://auth-service:8080",
    "UserProfileService": "http://userprofile-service:8080",
    "PortfolioService": "http://portfolio-service:8080",
    "CompanyService": "http://company-service:8080",
    "JobHiringService": "http://jobhiring-service:8080",
    "ConnectionService": "http://connection-service:8080",
    "CommunityService": "http://community-service:8080",
    "SubscriptionService": "http://subscription-service:8080",
    "AdvertisementService": "http://advertisement-service:8080",
    "ModerationService": "http://moderation-service:8080",
    "NotificationService": "http://notification-service:8080"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "userprofile-route": {
        "ClusterId": "userprofile-cluster",
        "Match": {
          "Path": "/api/userprofile/{**catch-all}"
        }
      },
      "portfolio-route": {
        "ClusterId": "portfolio-cluster",
        "Match": {
          "Path": "/api/portfolio/{**catch-all}"
        }
      },
      "company-route": {
        "ClusterId": "company-cluster",
        "Match": {
          "Path": "/api/company/{**catch-all}"
        }
      },
      "jobhiring-route": {
        "ClusterId": "jobhiring-cluster",
        "Match": {
          "Path": "/api/jobhiring/{**catch-all}"
        }
      },
      "connection-route": {
        "ClusterId": "connection-cluster",
        "Match": {
          "Path": "/api/connection/{**catch-all}"
        }
      },
      "community-route": {
        "ClusterId": "community-cluster",
        "Match": {
          "Path": "/api/community/{**catch-all}"
        }
      },
      "subscription-route": {
        "ClusterId": "subscription-cluster",
        "Match": {
          "Path": "/api/subscription/{**catch-all}"
        }
      },
      "advertisement-route": {
        "ClusterId": "advertisement-cluster",
        "Match": {
          "Path": "/api/advertisement/{**catch-all}"
        }
      },
      "moderation-route": {
        "ClusterId": "moderation-cluster",
        "Match": {
          "Path": "/api/moderation/{**catch-all}"
        }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notification/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://auth-service:8080"
          }
        }
      },
      "userprofile-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://userprofile-service:8080"
          }
        }
      },
