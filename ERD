        int Id PK
        string Code UK
        bool IsMultiple
        bool IsActive
    }
    PORTFOLIO_BLOCK {
        int Id PK
        int PortfolioId FK
        int BlockTypeId FK
        string Variant
        int DisplayOrder
        bool IsVisible
        string DataJson
    }
    COMPLIMENT {
        int Id PK
        int PortfolioId FK
        int UserId
        string Content
        int Score
        int State
        datetime CreatedAt
        datetime UpdatedAt
    }
    PORTFOLIO_FOLLOW_CATEGORY {
        int Id PK
        int CompanyId
        string Name
        string Code
        datetime CreatedAt
        datetime UpdatedAt
    }
    PORTFOLIO_FOLLOW {
        int Id PK
        int CompanyId
        int PortfolioId FK
        int CategoryId FK
        string InterestLevel
        datetime FollowedAt
        datetime UpdatedAt
    }

    PORTFOLIO ||--o{ PORTFOLIO_BLOCK : contains
