    %% =======================
    %% AUTH SERVICE
    %% =======================
    USER {
        int Id PK
        string Email UK
        string PasswordHash
        int Role
        int Status
        datetime CreatedAt
    }
    REFRESH_TOKEN {
        int Id PK
        int UserId FK
        string Token
        datetime ExpiredAt
        bool Revoked
    }
    USER ||--o{ REFRESH_TOKEN : has

